# Copy to .env.local. Every value has a working default for devnet.

# ---------------------------------------------------------------------------
# RPC
# ---------------------------------------------------------------------------
# Set ONE of the two.
#
# RPC_URL is server only. The browser talks to /api/rpc and the route handler
# forwards, so an API key in the URL never reaches the bundle. Use this on any
# deployment.
#
#   RPC_URL=https://devnet.helius-rpc.com/?api-key=...
#
# NEXT_PUBLIC_RPC_URL is read by the browser directly, which is simpler for
# local work but puts the whole URL, key included, into the JavaScript bundle.
# Never point it at a key you care about.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# With neither set, both paths end at the public devnet endpoint. It needs no
# key and rate limits getProgramAccounts hard.

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Defaults are the live devnet deployment. Override only for another deploy.
# NEXT_PUBLIC_PROGRAM_ID=7L9xYzMLHNRtnQYB9w7Djx4UAAmW3CnJxLHhEHJnRW6Q
# NEXT_PUBLIC_QUOTE_MINT=8opqdnKkNEgneiJWkfW8EExTfpKssRqXuR6BBY86uYCu
