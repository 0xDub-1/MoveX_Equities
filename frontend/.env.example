# Copy to .env.local. Every value has a working default for devnet.

# RPC endpoint. The public devnet endpoint rate limits getProgramAccounts, so
# a Helius devnet URL is recommended. Note that anything NEXT_PUBLIC_ ships to
# the browser, so use a key you are comfortable exposing.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Defaults are the live devnet deployment. Override only for another deploy.
# NEXT_PUBLIC_PROGRAM_ID=9j2X63EpuSxBSqfMKNrcbQUFzzrXiU8ok2PbUYucZ8zL
# NEXT_PUBLIC_QUOTE_MINT=FBnaipfxQK8M3ZMMM3bwnzgbgKDLPGJ2rJdUANHocBve
